{
  "name": "h5p-oksigenia",
  "private": true,
  "description": "Oksigenia's games for H5P",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "pack": "node tools/build.mjs && node tools/pack.mjs",
    "test": "node --test packages/*/test/*.test.mjs",
    "lang": "node tools/language.mjs",
    "dev": "node tools/build.mjs && node tools/dev.mjs",
    "e2e": "node tools/build.mjs && playwright test",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lumieducation/h5p-express": "9.3.3",
    "@lumieducation/h5p-server": "9.3.3",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "h5p-cli": "1.1.7",
    "typescript": "7.0.2"
  }
}
