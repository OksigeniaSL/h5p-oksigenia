[
  {
    "name": "topic",
    "type": "select",
    "label": "What to practise",
    "importance": "high",
    "description": "With «Choose when starting», whoever plays picks it on the first screen: handy in the middle of a class.",
    "options": [
      {
        "value": "choose",
        "label": "Choose when starting"
      },
      {
        "value": "add20",
        "label": "Addition and subtraction up to 20"
      },
      {
        "value": "add100",
        "label": "Addition and subtraction up to 100"
      },
      {
        "value": "tables",
        "label": "Times tables"
      },
      {
        "value": "place1000",
        "label": "Whole numbers up to 1000"
      },
      {
        "value": "fractions",
        "label": "Fractions"
      },
      {
        "value": "free",
        "label": "Free line, with no points"
      }
    ],
    "default": "choose"
  },
  {
    "name": "character",
    "type": "select",
    "label": "The piece that jumps",
    "importance": "medium",
    "description": "The spring suits younger children best and the dice, older ones. If players choose, they see only the drawing and the name, with no age.",
    "options": [
      {
        "value": "choose",
        "label": "Let the player choose"
      },
      {
        "value": "muelle",
        "label": "Spring"
      },
      {
        "value": "cohete",
        "label": "Rocket"
      },
      {
        "value": "dado",
        "label": "Dice"
      }
    ],
    "default": "choose"
  },
  {
    "name": "rounds",
    "type": "number",
    "label": "Rounds in a game",
    "importance": "medium",
    "min": 1,
    "max": 30,
    "default": 6
  },
  {
    "name": "tuning",
    "type": "group",
    "label": "Fine tuning",
    "importance": "low",
    "optional": true,
    "description": "Optional. What you fill in here makes a single level with those numbers. The rest can stay empty.",
    "fields": [
      {
        "name": "maxNumber",
        "type": "number",
        "label": "End of the line",
        "importance": "low",
        "optional": true,
        "min": 1,
        "description": "For sums and for placing numbers: 30, 200, 1000…"
      },
      {
        "name": "jumps",
        "type": "text",
        "label": "Jumps for sums and subtractions",
        "importance": "low",
        "optional": true,
        "description": "For example: +1 +5 +10 -1"
      },
      {
        "name": "tables",
        "type": "text",
        "label": "Times tables",
        "importance": "low",
        "optional": true,
        "description": "For example: 7, 8, 9"
      },
      {
        "name": "denominators",
        "type": "text",
        "label": "Denominators of the fractions",
        "importance": "low",
        "optional": true,
        "description": "For example: 2, 4, 8"
      }
    ]
  },
  {
